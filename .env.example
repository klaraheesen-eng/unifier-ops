# Copy to .env locally and fill values. Never commit .env.
#
# Unity MCP — direct IIS endpoints (scripts/unity-cli.mjs) and same token the relay uses upstream.
# Get the value aligned with IIS Application("mcp-bearer-token") / unity/mcp/mcp_auth.asp.
UNITY_MCP_TOKEN=
#
# Optional: only if you call the Cloudflare MCP relay from custom clients (SSE) — not needed for unity-cli.
# UNITY_EDGE_AUTH_TOKEN=
#
# Base URL for mcp_*.asp (trailing slash optional)
UNITY_BASE_URL=https://www.unifier.co.za/unity/mcp/
